{
  "info": {
    "name": "Job Application Tracker API",
    "description": "Signup, login and CRUD on job applications. After request 3, copy the _id from the response into the collection variable 'id' so requests 5, 6 and 7 use it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "id",
      "value": "PASTE_THE_ID_FROM_REQUEST_3"
    }
  ],
  "item": [
    {
      "name": "1. Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "signup"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sherif Ahmed\",\n  \"email\": \"sherif@example.com\",\n  \"password\": \"Sherif2024!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "login"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sherif@example.com\",\n  \"password\": \"Sherif2024!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Create application",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "create"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company\": \"Vodafone Egypt\",\n  \"position\": \"Junior Backend Developer\",\n  \"location\": \"Cairo\",\n  \"salary\": 15000,\n  \"notes\": \"Applied through LinkedIn\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "4. Get all applications",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/applications/getallapplications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "getallapplications"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "5. Get application by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/applications/getapplication/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "getapplication",
            "{{id}}"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "6. Update application",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications/updateapplication/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "updateapplication",
            "{{id}}"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company\": \"Vodafone Egypt\",\n  \"position\": \"Junior Backend Developer\",\n  \"status\": \"interview\",\n  \"notes\": \"HR call booked\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. Delete application",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/applications/deleteapplication/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "deleteapplication",
            "{{id}}"
          ]
        },
        "description": ""
      }
    }
  ]
}